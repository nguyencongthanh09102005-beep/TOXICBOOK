# Create .env.local, never commit it.
# Required for AI-generated comments and image understanding:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Recommended on local, mandatory when deployed on Vercel (owner-only app):
TOXICBOOK_OWNER_PASSWORD=
# Optional: fixed secret for owner login cookies. Make it long and random.
TOXICBOOK_SESSION_SECRET=
# Required only for cloud deployment/data synchronization. See supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
